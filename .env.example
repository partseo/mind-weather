# ============================================================
#  🌍 Global Used Car Export Platform — Environment Variables
#  도메인 변경 시 APP_DOMAIN 하나만 수정하면 전체 적용됩니다.
# ============================================================

# --- 앱 기본 설정 ---
APP_NAME="Korea Auto Export"
APP_DOMAIN="https://yourdomain.com"
APP_LOGO_URL="/logo.png"
APP_ENV="development"  # development | production

# --- 연락처 (WhatsApp / Telegram) ---
APP_WHATSAPP="+82-10-XXXX-XXXX"
APP_TELEGRAM="@yourhandle"
APP_EMAIL="contact@yourdomain.com"

# --- 데이터베이스 ---
DATABASE_URL="postgresql+asyncpg://autoexport:password@localhost:5432/autoexport_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis 캐시 ---
REDIS_URL="redis://localhost:6379/0"

# --- JWT 보안 ---
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AWS S3 (이미지 저장) ---
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="autoexport-vehicle-images"
AWS_S3_REGION="ap-northeast-2"

# --- Cloudflare (배포 시 자동 도메인 교체) ---
CLOUDFLARE_API_KEY=""
CLOUDFLARE_ZONE_ID=""

# --- CORS (프론트엔드 도메인) ---
# 개발: http://localhost:3000
# 운영: APP_DOMAIN 값을 자동 참조
CORS_ORIGINS='["http://localhost:3000","https://yourdomain.com"]'

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- 어드민 초기 계정 ---
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
